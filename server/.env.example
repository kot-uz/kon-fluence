NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://kon:kon@localhost:5433/kon_fluence

# Секрет подписи access-токенов (не короче 32 символов); в продакшене заменить
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
AUTH_RATE_LIMIT_MAX=10

# S3 (MinIO локально); используются с этапа 6
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=kon-fluence
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
