# Базовый URL бекенда, к которому добавляется /docs/...
# Если пусто, облачный режим хранения скрыт, данные лежат только на устройстве.
REACT_APP_API_URL=
# Адрес бекенда для dev-прокси Vite (/docs и /auth). При работе через прокси
# REACT_APP_API_URL указывает на сам dev-сервер, например http://localhost:3010.
DEV_API_PROXY_TARGET=http://localhost:3000
